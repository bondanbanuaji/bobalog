generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id              String        @id @default(cuid())
  userId          String

  // Source
  shopeeUrl       String
  shopeeProductId String?

  // Core Data
  title           String
  thumbnail       String?
  gallery         String[]
  price           Int           // dalam rupiah
  originalPrice   Int?
  discountPercent Int?

  // Shop Info
  shopId          String?
  shop            Shop?         @relation(fields: [shopId], references: [id])
  shopName        String?       // Cached shop name
  shopUrl         String?       // Cached shop url

  // Product Stats
  rating          Float?
  soldCount       Int?
  stock           Int?
  variations      Json?         // detail pilihan variasi

  // User Notes
  notes           String?
  priority        Priority      @default(NORMAL)
  status          ProductStatus @default(ACTIVE)

  // Scrape State
  scrapeStatus    ScrapeStatus  @default(PENDING)
  lastScraped     DateTime?

  // Analytics & Insight
  views           Int           @default(0)
  clicks          Int           @default(0)
  aiInsight       AiInsight?

  // Relations
  priceHistory    PriceHistory[]
  collections     CollectionProduct[]
  tags            ProductTag[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([shopeeUrl])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Int
  checkedAt DateTime @default(now())

  @@index([productId])
}

model Collection {
  id          String              @id @default(cuid())
  userId      String

  name        String
  description String?
  emoji       String?             // "🎮", "💻", "👟", "🧴", "💸"
  color       String?             // Hex color untuk card accent
  isPublic    Boolean             @default(false)
  shareToken  String?             @unique @default(cuid())
  sortOrder   Int                 @default(0)

  products    CollectionProduct[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([shareToken])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, productId])
}

model Tag {
  id       String       @id @default(cuid())
  userId   String
  name     String
  color    String?

  products ProductTag[]

  @@unique([userId, name])
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  MUST_BUY
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  BOUGHT
  UNAVAILABLE
}

enum ScrapeStatus {
  PENDING
  PREVIEW
  BASIC
  FULL
  FAILED
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Shop {
  id              String        @id @default(cuid())
  userId          String
  
  name            String
  url             String?
  username        String?
  rating          Float?
  totalSales      Int?
  location        String?

  products        Product[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@unique([userId, name])
}

model ScrapeJob {
  id              String        @id @default(cuid())
  userId          String
  targetUrl       String
  status          ScrapeJobStatus @default(PENDING)
  priority        Priority      @default(NORMAL)
  errorMessage    String?       @db.Text
  
  logs            ScrapeLog[]
  
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([userId])
}

model ScrapeLog {
  id              String        @id @default(cuid())
  jobId           String
  job             ScrapeJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  message         String        @db.Text
  level           String        @default("INFO")
  
  createdAt       DateTime      @default(now())
  
  @@index([jobId])
}

model AiInsight {
  id              String        @id @default(cuid())
  productId       String        @unique
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  summary         String?       @db.Text
  pros            String[]
  cons            String[]
  viralScore      Int?
  autoCategory    String?
  isTrending      Boolean       @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
